generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  PERSONAL_SHOPPER
  HANDYMAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique @db.VarChar(100)
  email         String       @unique @db.VarChar(255)
  password      String?
  role          UserRole     @default(CUSTOMER)
  status        UserStatus   @default(PENDING)
  // Bug #12: superseded by RefreshSession — no code reads or writes this
  // anymore. Deliberately NOT dropped in the same migration/deploy that
  // retires it: deploy.yml runs migrations before the old server process
  // reloads, so a DROP COLUMN here would make the still-running old
  // process's `SELECT * FROM users` (every authenticated request, via
  // JwtStrategy) fail until the reload completes a few seconds later.
  // Drop this column in its own later migration once this code has been
  // live for a while.
  refreshToken  String?      @map("refresh_token")
  avatar        String?      @db.VarChar(500)
  phone         String?      @db.VarChar(20)
  emailVerified Boolean      @default(false) @map("email_verified")
  onboardedAt   DateTime?    @map("onboarded_at")
  lastLoginAt   DateTime?    @map("last_login_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  // OAuth fields
  provider      AuthProvider @default(LOCAL)
  googleId      String?      @unique @map("google_id")

  // Relations
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  refreshSessions     RefreshSession[]
  handymanProfile     HandymanProfile?
  shopperProfile      ShopperProfile?
  reviewedShoppers    ShopperProfile[]    @relation("ShopperReviewedByAdmin")
  reviewedHandymen    HandymanProfile[]   @relation("ReviewedByAdmin")
  reviewedDocuments   HandymanDocument[]  @relation("DocumentReviewedBy")
  customerServiceRequests ServiceRequest[] @relation("CustomerRequests")
  auditLogs               AuditLog[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  shoppingRequests        ShoppingRequest[]
  shopperOrdersAsCustomer ShopperOrder[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// Bug #12: one `refreshToken` column per user meant logging in on a second
// device logged out the first, since every login/refresh overwrote the same
// row. One row per session fixes that: login/register INSERT a new row
// without touching any other device's; refresh rotates (updates) only the
// row it validated against; logout revokes one row or all of a user's rows.
model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  // SHA-256 of the refresh token (see hashToken) — deterministic, so this
  // can be looked up by equality rather than scanned and compared one by one.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

// Waitlist enums
enum WaitlistRole {
  USER
  HANDYMAN
  SHOPPER
}

enum HowFindHelp {
  FRIENDS_FAMILY
  WHATSAPP
  SOCIAL_MEDIA
  STRUGGLE
}

enum FirstService {
  HANDYMAN
  PERSONAL_SHOPPER
  BOTH
}

enum WillingToPay {
  YES
  MAYBE
  NO
}

enum MonthlyBudget {
  BUDGET_1000_3000
  BUDGET_3000_5000
  BUDGET_5000_PLUS
}

enum UsedOwnMoney {
  YES
  NO
}

enum MaxSpendingAmount {
  UNDER_10000
  AMOUNT_10000_30000
  AMOUNT_30000_PLUS
}

enum PayoutSpeed {
  IMMEDIATELY
  SAME_DAY
  WITHIN_24_HOURS
}

model Waitlist {
  id        String        @id @default(uuid())
  fullName  String        @map("full_name") @db.VarChar(255)
  email     String        @unique @db.VarChar(255)
  city      String        @db.VarChar(100)
  role      WaitlistRole

  // User-specific fields
  howFindHelp   HowFindHelp?   @map("how_find_help")
  firstService  FirstService?  @map("first_service")
  frustration   String?        @db.Text

  // Handyman-specific fields
  mainSkill     String?        @map("main_skill") @db.VarChar(100)
  willingToPay  WillingToPay?  @map("willing_to_pay")
  monthlyBudget MonthlyBudget? @map("monthly_budget")

  // Shopper-specific fields
  usedOwnMoney      UsedOwnMoney?      @map("used_own_money")
  maxSpendingAmount MaxSpendingAmount? @map("max_spending_amount")
  payoutSpeed       PayoutSpeed?       @map("payout_speed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("waitlist")
}

// ==================== HANDYMAN DASHBOARD ====================

enum VerificationStatus {
  UNVERIFIED
  PROFILE_COMPLETE
  DOCUMENTS_SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentType {
  GOVERNMENT_ID
  SELFIE
  PROOF_OF_ADDRESS
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  // Bug #10: the handyman marking a job complete and the customer confirming
  // it were the same transition (both went straight to COMPLETED from
  // IN_PROGRESS), so either side could unilaterally close the job and the
  // other's "confirmation" never actually happened. This splits the step:
  // the handyman moves here, the customer confirms from here to COMPLETED.
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  handymanProfiles HandymanProfileCategory[]
  serviceRequests  ServiceRequest[]

  @@map("service_categories")
}

model HandymanProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  bio                String?            @db.Text
  location           String?            @db.VarChar(255)
  latitude           Float?
  longitude          Float?
  hourlyRate         Decimal?           @map("hourly_rate") @db.Decimal(10, 2)
  yearsOfExperience  Int?               @map("years_of_experience")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  reviewedById       String?            @map("reviewed_by_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?                        @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])
  documents          HandymanDocument[]
  categories         HandymanProfileCategory[]
  assignedRequests   ServiceRequest[]             @relation("AssignedHandyman")
  applications       ServiceRequestApplication[]

  @@index([verificationStatus])
  @@map("handyman_profiles")
}

model HandymanProfileCategory {
  handymanProfileId String @map("handyman_profile_id")
  categoryId        String @map("category_id")

  handymanProfile HandymanProfile @relation(fields: [handymanProfileId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([handymanProfileId, categoryId])
  @@map("handyman_profile_categories")
}

model HandymanDocument {
  id                String         @id @default(uuid())
  handymanProfileId String         @map("handyman_profile_id")
  type              DocumentType
  // Object storage key, never a URL: every read path (GET /handyman/profile,
  // GET /handyman/documents, the upload response, and the admin review
  // endpoints) maps this to a short-lived signed URL before it reaches a
  // client (bug #17 — this used to be a permanent, often-public URL stored
  // straight in the database).
  fileKey            String         @map("file_key") @db.VarChar(500)
  fileName          String         @map("file_name") @db.VarChar(255)
  status            DocumentStatus @default(PENDING)
  rejectionReason   String?        @map("rejection_reason") @db.Text
  reviewedById      String?        @map("reviewed_by_id")
  reviewedAt        DateTime?      @map("reviewed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  handymanProfile HandymanProfile @relation(fields: [handymanProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?           @relation("DocumentReviewedBy", fields: [reviewedById], references: [id])

  @@index([handymanProfileId])
  @@map("handyman_documents")
}

model ServiceRequest {
  id                  String               @id @default(uuid())
  customerId          String               @map("customer_id")
  categoryId          String               @map("category_id")
  title               String               @db.VarChar(255)
  description         String               @db.Text
  location            String               @db.VarChar(255)
  latitude            Float?
  longitude           Float?
  budgetMin           Decimal?             @map("budget_min") @db.Decimal(10, 2)
  budgetMax           Decimal?             @map("budget_max") @db.Decimal(10, 2)
  status              ServiceRequestStatus @default(OPEN)
  assignedHandymanId  String?              @map("assigned_handyman_id")
  completedAt         DateTime?            @map("completed_at")
  cancelledAt         DateTime?            @map("cancelled_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  // Relations
  customer          User                         @relation("CustomerRequests", fields: [customerId], references: [id])
  category          ServiceCategory              @relation(fields: [categoryId], references: [id])
  assignedHandyman  HandymanProfile?             @relation("AssignedHandyman", fields: [assignedHandymanId], references: [id])
  applications      ServiceRequestApplication[]

  @@index([customerId])
  @@index([assignedHandymanId])
  @@index([status])
  @@index([customerId, status])
  @@index([assignedHandymanId, status])
  @@map("service_requests")
}

model ServiceRequestApplication {
  id                String            @id @default(uuid())
  serviceRequestId  String            @map("service_request_id")
  handymanProfileId String            @map("handyman_profile_id")
  coverMessage      String?           @map("cover_message") @db.Text
  proposedRate      Decimal?          @map("proposed_rate") @db.Decimal(10, 2)
  status            ApplicationStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  handymanProfile HandymanProfile @relation(fields: [handymanProfileId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, handymanProfileId])
  @@index([handymanProfileId, status])
  @@map("service_request_applications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(100)
  entityId    String?  @map("entity_id")
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== PERSONAL SHOPPER ====================

enum ShopperAccountState {
  REGISTERED
  ONBOARDING
  VERIFICATION_PENDING
  VERIFICATION_REQUIRES_UPDATE
  APPROVED
  SUSPENDED
  DEACTIVATED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Reference data the shopper onboarding form is built from. Admin-editable
// rows, not code constants: the client sends ids and never names.
model ShoppingCategory {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  icon      String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shopperProfiles ShopperProfileCategory[]
  requestItems    ShoppingRequestItem[]

  @@map("shopping_categories")
}

model ShoppingLocation {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shopperProfiles ShopperProfileLocation[]
  requests        ShoppingRequest[]
  orders          ShopperOrder[]

  @@map("shopping_locations")
}

// Optional extra services a shopper can perform. The fee is configured by
// Fetchit (whole NGN, no minor units); a shopper confirms it but cannot set it.
model ExtraService {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  fee         Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shopperProfiles ShopperProfileService[]

  @@map("extra_services")
}

model ShopperProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique @map("user_id")
  accountState          ShopperAccountState @default(REGISTERED) @map("account_state")
  displayName           String?             @map("display_name") @db.VarChar(100)
  bio                   String?             @db.Text
  yearsOfExperience     Int?                @map("years_of_experience")
  isOnline              Boolean             @default(false) @map("is_online")
  rating                Decimal?            @db.Decimal(3, 2)
  completedOrders       Int                 @default(0) @map("completed_orders")
  completionRate        Decimal?            @map("completion_rate") @db.Decimal(5, 2)
  payoutAccountVerified Boolean             @default(false) @map("payout_account_verified")
  rejectionReason       String?             @map("rejection_reason") @db.Text
  submittedAt           DateTime?           @map("submitted_at")
  reviewedById          String?             @map("reviewed_by_id")
  reviewedAt            DateTime?           @map("reviewed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                    @relation("ShopperReviewedByAdmin", fields: [reviewedById], references: [id])
  categories   ShopperProfileCategory[]
  locations    ShopperProfileLocation[]
  services     ShopperProfileService[]
  availability ShopperAvailability[]
  offers       ShoppingOffer[]
  orders       ShopperOrder[]

  @@index([accountState])
  @@map("shopper_profiles")
}

model ShopperProfileCategory {
  shopperProfileId String @map("shopper_profile_id")
  categoryId       String @map("category_id")

  shopperProfile ShopperProfile   @relation(fields: [shopperProfileId], references: [id], onDelete: Cascade)
  category       ShoppingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([shopperProfileId, categoryId])
  @@map("shopper_profile_categories")
}

model ShopperProfileLocation {
  shopperProfileId String @map("shopper_profile_id")
  locationId       String @map("location_id")

  shopperProfile ShopperProfile   @relation(fields: [shopperProfileId], references: [id], onDelete: Cascade)
  location       ShoppingLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([shopperProfileId, locationId])
  @@map("shopper_profile_locations")
}

model ShopperProfileService {
  shopperProfileId String @map("shopper_profile_id")
  serviceId        String @map("service_id")

  shopperProfile ShopperProfile @relation(fields: [shopperProfileId], references: [id], onDelete: Cascade)
  service        ExtraService   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([shopperProfileId, serviceId])
  @@map("shopper_profile_services")
}

model ShopperAvailability {
  id               String  @id @default(uuid())
  shopperProfileId String  @map("shopper_profile_id")
  weekday          Weekday
  startTime        String? @map("start_time") @db.VarChar(5)
  endTime          String? @map("end_time") @db.VarChar(5)

  shopperProfile ShopperProfile @relation(fields: [shopperProfileId], references: [id], onDelete: Cascade)

  @@unique([shopperProfileId, weekday])
  @@map("shopper_availability")
}

// ---- Shopping requests and offers (customer request -> shopper bids) ----

enum ShoppingRequestStatus {
  OPEN
  // Reserved for accepting an offer (a later slice); nothing sets it yet.
  ASSIGNED
  CANCELLED
  EXPIRED
}

enum SubstitutionPreference {
  REFUND
  SIMILAR_UP_TO
}

enum ShoppingOfferState {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model ShoppingRequest {
  id                   String                @id @default(uuid())
  reference            String                @unique @db.VarChar(20)
  customerId           String                @map("customer_id")
  status               ShoppingRequestStatus @default(OPEN)
  shoppingLocationId   String                @map("shopping_location_id")
  // Coarse area shown to shoppers. The exact address is never sent to them.
  handoffArea          String?               @map("handoff_area") @db.VarChar(100)
  deliveryAddress      String                @map("delivery_address") @db.Text
  deliveryLatitude     Float?                @map("delivery_latitude")
  deliveryLongitude    Float?                @map("delivery_longitude")
  note                 String?               @db.Text
  // Whole NGN: sum of quantity x estimatedUnitPrice, fixed at creation.
  estimatedGoodsBudget Int                   @map("estimated_goods_budget")
  // Server-calculated estimate shown to the customer at creation.
  estimate             Json
  offerDeadline        DateTime              @map("offer_deadline")
  cancelledAt          DateTime?             @map("cancelled_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  customer         User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shoppingLocation ShoppingLocation      @relation(fields: [shoppingLocationId], references: [id])
  items            ShoppingRequestItem[]
  offers           ShoppingOffer[]
  // Several over time: a cancelled order reopens the request, which can be accepted again.
  orders           ShopperOrder[]

  @@index([customerId, createdAt])
  @@index([status, shoppingLocationId, offerDeadline])
  @@map("shopping_requests")
}

model ShoppingRequestItem {
  id                     String                 @id @default(uuid())
  requestId              String                 @map("request_id")
  position               Int
  name                   String                 @db.VarChar(150)
  brand                  String                 @db.VarChar(100)
  size                   String                 @db.VarChar(50)
  quantity               Int
  unit                   String                 @db.VarChar(30)
  estimatedUnitPrice     Int                    @map("estimated_unit_price")
  notes                  String?                @db.Text
  substitutionPreference SubstitutionPreference @default(REFUND) @map("substitution_preference")
  maxSubstitutePrice     Int?                   @map("max_substitute_price")
  // Optional: only used to match the request to shoppers who cover the category.
  categoryId             String?                @map("category_id")

  request  ShoppingRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category ShoppingCategory? @relation(fields: [categoryId], references: [id])

  @@index([requestId])
  @@index([categoryId])
  @@map("shopping_request_items")
}

// A shopper's bid: their fee and ETA only. The partial unique index
// "shopping_offers_one_pending_per_shopper" (request_id, shopper_profile_id)
// WHERE state = 'PENDING' lives in the migration SQL; Prisma cannot express it.
model ShoppingOffer {
  id               String             @id @default(uuid())
  requestId        String             @map("request_id")
  shopperProfileId String             @map("shopper_profile_id")
  state            ShoppingOfferState @default(PENDING)
  shopperFee       Int                @map("shopper_fee")
  etaMinutes       Int                @map("eta_minutes")
  note             String?            @db.Text
  expiresAt        DateTime           @map("expires_at")
  // Breakdown calculated at submit time and kept as quoted.
  financials       Json
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  request        ShoppingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shopperProfile ShopperProfile  @relation(fields: [shopperProfileId], references: [id], onDelete: Cascade)
  orders         ShopperOrder[]

  @@index([requestId, state])
  @@index([shopperProfileId, state, createdAt])
  @@map("shopping_offers")
}

// Singleton (id is always 1, enforced in the migration): the admin-editable
// fee rules every shopping price is calculated from. Money is whole NGN;
// percentages are plain percents (7.50 = 7.5%).
model ShoppingConfig {
  id                   Int      @id @default(1)
  minShopperFee        Int      @map("min_shopper_fee")
  maxShopperFee        Int      @map("max_shopper_fee")
  deliveryFee          Int      @map("delivery_fee")
  serviceChargePercent Decimal  @map("service_charge_percent") @db.Decimal(5, 2)
  vatPercent           Decimal  @map("vat_percent") @db.Decimal(5, 2)
  priceBufferPercent   Decimal  @map("price_buffer_percent") @db.Decimal(5, 2)
  offerWindowMinutes   Int      @map("offer_window_minutes")
  // How long a shopper has to accept an ASSIGNED order before it is cancelled.
  shopperAcceptWindowMinutes Int   @default(30) @map("shopper_accept_window_minutes")
  // How long a PENDING offer stays acceptable after BIDDING closes (the request's
  // offerDeadline): expiresAt = offerDeadline + this.
  offerAcceptanceWindowMinutes Int @default(1440) @map("offer_acceptance_window_minutes")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("shopping_config")
}

// ---- Orders: what an accepted offer becomes ----

// Matches docs/personal-shopper-backend.md section 2.2 (the states the built
// frontend uses), not the different list in backend-feature-requirements B6.
enum OrderState {
  ASSIGNED
  SHOPPER_ACCEPTED
  SHOPPING_STARTED
  AWAITING_APPROVAL
  PREPARATION
  RECEIPT_PENDING
  SHOPPING_COMPLETED
  READY_FOR_HANDOFF
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum OrderItemState {
  PENDING
  FOUND
  PRICE_CHANGE_REQUESTED
  PRICE_APPROVED
  PRICE_REJECTED
  UNAVAILABLE
  SUBSTITUTION_REQUESTED
  SUBSTITUTION_APPROVED
  SUBSTITUTION_REJECTED
  PURCHASED
  REMOVED
}

// Created UNPAID when the customer accepts an offer. Payment, escrow and wallet
// (Part C) are not built: nothing is charged anywhere in this model.
model ShopperOrder {
  id                 String     @id @default(uuid())
  reference          String     @unique @db.VarChar(20)
  // Not @unique: uniqueness is a partial index over non-cancelled orders (see the migration).
  requestId          String     @map("request_id")
  offerId            String     @map("offer_id")
  customerId         String     @map("customer_id")
  shopperProfileId   String     @map("shopper_profile_id")
  state              OrderState @default(ASSIGNED)
  shoppingLocationId String     @map("shopping_location_id")
  handoffArea        String?    @map("handoff_area") @db.VarChar(100)
  handoffAt          DateTime?  @map("handoff_at")
  // Copied verbatim from the accepted offer's stored breakdown; never recomputed here.
  financials         Json
  shopperAcceptedAt  DateTime?  @map("shopper_accepted_at")
  shoppingStartedAt  DateTime?  @map("shopping_started_at")
  cancelledAt        DateTime?  @map("cancelled_at")
  // CUSTOMER, SYSTEM (the shopper never accepted in time) or SHOPPER (later slices).
  cancelledBy        String?    @map("cancelled_by") @db.VarChar(16)
  cancelReason       String?    @map("cancel_reason") @db.Text
  // Also the moment the order was assigned: the accept window counts from it.
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  request          ShoppingRequest   @relation(fields: [requestId], references: [id])
  offer            ShoppingOffer     @relation(fields: [offerId], references: [id])
  customer         User              @relation(fields: [customerId], references: [id])
  shopperProfile   ShopperProfile    @relation(fields: [shopperProfileId], references: [id])
  shoppingLocation ShoppingLocation  @relation(fields: [shoppingLocationId], references: [id])
  items            ShopperOrderItem[]
  events           OrderEvent[]

  @@index([customerId, createdAt])
  @@index([shopperProfileId, createdAt])
  // Also answers "was this shopper's order on this request cancelled?" (re-bid block).
  @@index([requestId, shopperProfileId])
  @@index([offerId])
  @@map("shopper_orders")
}

// A copy of a request item. The price columns are deliberately separate (an
// estimate, a requested change, an approved amount and the final purchase
// amount are different facts); blank is not zero.
model ShopperOrderItem {
  id                     String                 @id @default(uuid())
  orderId                String                 @map("order_id")
  requestItemId          String?                @map("request_item_id")
  position               Int
  name                   String                 @db.VarChar(150)
  brand                  String                 @db.VarChar(100)
  size                   String                 @db.VarChar(50)
  quantity               Int
  unit                   String                 @db.VarChar(30)
  notes                  String?                @db.Text
  state                  OrderItemState         @default(PENDING)
  substitutionPreference SubstitutionPreference @default(REFUND) @map("substitution_preference")
  maxSubstitutePrice     Int?                   @map("max_substitute_price")
  // All whole NGN per unit.
  customerEstimatedPrice Int                    @map("customer_estimated_price")
  shopperEstimatedPrice  Int?                   @map("shopper_estimated_price")
  actualPurchasePrice    Int?                   @map("actual_purchase_price")
  approvedPrice          Int?                   @map("approved_price")
  finalPurchasePrice     Int?                   @map("final_purchase_price")

  order ShopperOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, position])
  @@map("shopper_order_items")
}

// Append-only audit trail of an order. `type` is a string (see ORDER_EVENT_TYPES
// in code) so later slices add types without a migration.
model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  type      String   @db.VarChar(64)
  actorId   String?  @map("actor_id")
  actorRole String?  @map("actor_role") @db.VarChar(32)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  order ShopperOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model PushSubscription {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  endpoint   String    @unique @db.VarChar(2048)
  p256dh     String    @db.VarChar(255)
  auth       String    @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  body      String?   @db.Text
  href      String?   @db.VarChar(512)
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}
