# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Bare number, no "v" prefix. Nest's URI versioning adds the "v" itself, so
# API_VERSION=v1 serves every route at /api/vv1 and all /api/v1 calls 404.
# Boot now fails loudly on a "v"-prefixed value rather than routing to nowhere.
API_VERSION=1
# REQUIRED. The frontend web app users open in a browser (NOT the API host).
# Verification email links and OAuth callback/redirect URLs are built from this.
# Per environment, e.g. dev: https://dev.fetchit.com.ng, prod: https://app.fetchit.com.ng
FRONTEND_URL=http://localhost:4200

# Database (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fetchit?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (REDIS_URL takes precedence - use for Upstash/cloud providers)
# For Upstash: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379
# Note: The app is resilient to Redis failures - it will continue working
# with degraded functionality (no queues, no Redis cache) if Redis is down
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cache (pluggable: 'memory' or 'redis')
CACHE_TYPE=memory
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=fetchit:cache:
CACHE_MAX_ITEMS=1000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Swagger
SWAGGER_ENABLED=false
SWAGGER_TITLE=FetchIt API
SWAGGER_DESCRIPTION=FetchIt Backend API Documentation
SWAGGER_VERSION=1.0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=FetchIt <onboarding@resend.dev>
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=FetchIt

# ---------------------------------------------------------------------------
# Storage (pluggable object storage)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER selects the backend:
#   neon             Neon Object Storage. PREFERRED - see below.
#                    S3-compatible, and the only driver besides s3-compatible
#                    whose signed URLs actually expire.
#   local            (default) filesystem. Development only - nothing serves
#                    these files over HTTP, deliberately.
#   cloudinary       Cloudinary. Its own API, not S3.
#   s3-compatible    any object store speaking the S3 wire protocol.
#
# "S3-compatible" is a protocol name, not a vendor. No AWS account is involved.
#
# Routes that write to storage:
#   POST /handyman/documents/upload   verification documents (stores + records)
#   POST /uploads                     avatars and shopping receipts, returns a URL
#
# --- Neon Object Storage (preferred) ----------------------------------------
# S3-compatible storage built into the Neon project that already backs the
# database, so there is no second provider to sign up for or bill. Buckets are
# branch-scoped and copy-on-write: fork a branch and it inherits a consistent
# snapshot of BOTH these files and the Postgres rows that point at them.
#
# Why this over Cloudinary for KYC documents: reads go through a real
# presigned URL with an expiry. The Cloudinary driver's "authenticated" URLs
# are signed but never expire, so one leaked URL is a permanent handle on an
# identity document (bug #17).
#
# PRECONDITION - region. Neon Object Storage is only available in
# aws-us-east-2, aws-us-east-1, aws-eu-central-1 and aws-ap-southeast-1.
# Check the project's region before switching; if it is elsewhere (eu-west-2,
# say) object storage cannot be enabled there and the bucket creation in
# `neon deploy` will fail.
#
# Setup:
#   1. The bucket is declared in neon.ts (`buckets: { "fetchit-uploads": {} }`)
#   2. `neon deploy`          creates it on the linked branch
#   3. `neon env pull`        writes the four AWS_* values below into .env if
#                             that file exists, otherwise .env.local
#   4. STORAGE_DRIVER=neon and STORAGE_NEON_BUCKET=fetchit-uploads
#      (the CLI does not write the bucket name - it is ours, from neon.ts, and
#      boot fails without it)
#   5. Copy across anything already stored. Switching the driver does NOT move
#      existing objects: a key written under `local` or `cloudinary` is looked
#      up in the Neon bucket, where it does not exist, so already-uploaded
#      handyman documents stop resolving. Nothing records which backend wrote a
#      given key, so there is no way to tell them apart after the fact. For the
#      local driver the files are still on the box under STORAGE_LOCAL_ROOT
#      (the deploy rsync excludes storage/), and the prefixes map 1:1:
#        neon bucket object put fetchit-uploads <key> --file <root>/<key>
#      Check what is there first: find <root> -type f | wc -l
#
# The four AWS_* names are not a sign that AWS is involved - they are what the
# Neon CLI injects, because the AWS SDKs read credentials from exactly those
# names with no extra config. They are BRANCH-SCOPED: every `neon env pull`,
# `neon checkout` or `neon deploy` rewrites them for the current branch, which
# is why they are read directly rather than copied into STORAGE_S3_* (a copy
# would silently keep pointing at a branch that has moved on).
#
# STORAGE_DRIVER=neon
# STORAGE_NEON_BUCKET=fetchit-uploads
# AWS_ENDPOINT_URL_S3=<branch S3 endpoint, from `neon env pull`>
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=<from `neon env pull`>
# AWS_SECRET_ACCESS_KEY=<from `neon env pull`>
#
# CAVEAT - POST /uploads returns an unsigned URL. A private bucket refuses it
# (403), so avatar and receipt URLs will not load. The app warns at boot.
#
# DO NOT make this bucket public_read to work around that. STORAGE_PUBLIC_BASE_URL
# only changes the address that gets built - it cannot make a private object
# readable, so the address only resolves if the bucket itself allows anonymous
# reads. This bucket also holds handyman KYC documents, under the same prefixes,
# and there is no per-prefix routing to separate them: opening it up would
# publish identity documents to anyone holding a key.
#
# The two safe options, both follow-up work rather than done here:
#   - a SEPARATE public_read bucket used only for avatars and receipts, with
#     STORAGE_PUBLIC_BASE_URL pointing at a CDN over that one
#   - callers store the key and sign on read
#
# Handyman document READS are unaffected either way: those already sign on read
# with an expiry.
#
# AWS_REGION has no default on purpose: SigV4 signs requests with the region,
# so a wrong value fails authentication outright rather than degrading.
# Path-style addressing is forced in code - Neon supports nothing else - so
# STORAGE_S3_FORCE_PATH_STYLE does not apply to this driver.
#
# Inside a deployed Neon Function these four are injected automatically and
# none of them need setting by hand.
#
# TRAP - real environment variables beat .env. Neither dotenv nor
# @nestjs/config overwrites a variable the process already has, so on a host
# that exports AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for some unrelated
# reason (a CI runner, an agent sandbox, an aws-cli profile exported in a
# shell profile), `neon env pull` writes .env.local and it is SILENTLY
# IGNORED - the app then signs Neon requests with the foreign key and every
# request fails SigV4 with nothing pointing at the cause. Check with
# `env | grep ^AWS_` on the box before blaming the bucket. The app warns at
# boot if AWS_ENDPOINT_URL_S3 is not a *.neon.tech host, which is the usual
# tell. Unset the stray variables, or run via `neon-env run --`, which
# injects at runtime instead of through a file.
#
# --- Cloudinary -------------------------------------------------------------
# Sign up at https://cloudinary.com - no payment card required, unlike R2.
# All three values are on the dashboard under Account Details.
#
# STORAGE_DRIVER=cloudinary
# STORAGE_CLOUDINARY_CLOUD_NAME=<cloud-name>
# STORAGE_CLOUDINARY_API_KEY=<api-key>
# STORAGE_CLOUDINARY_API_SECRET=<api-secret>
#
# Two things to know about this driver:
#
# 1. Files are uploaded with Cloudinary's "authenticated" delivery type, so
#    they are NOT served from a public URL - a request without a valid
#    signature is refused. The signature is baked into the URL we store, and
#    carries no expiry, so a stored URL keeps working. Treat that URL as a
#    bearer credential: it is unguessable, but anyone holding it can fetch the
#    file. Do not paste document URLs into tickets or logs.
#
# 2. PDFs are stored as Cloudinary "raw" assets rather than image assets,
#    because PDF delivery under the image type is disabled by default on
#    Cloudinary accounts. That default is worked around, not relied on - no
#    account setting needs changing.
#
# The free plan bills storage, delivery bandwidth and transformations against
# one shared monthly credit pool, so document downloads draw on the same
# allowance as the documents themselves. Watch usage in the dashboard.
#
# --- Alternative: Cloudflare R2 (needs a payment card to activate) ----------
# R2 speaks the S3 protocol, and its free tier covers this use case (handyman
# verification documents: a handful of MB per handyman) with a lot of headroom.
# R2 also charges nothing for egress, unlike most object stores. Check current
# limits and pricing at https://developers.cloudflare.com/r2/pricing/
#
# Create a bucket in the Cloudflare dashboard (R2 > Create bucket), then an R2
# API token (R2 > Manage API tokens) with Object Read & Write on that bucket.
# Keep the bucket PRIVATE - these are KYC documents.
#
# STORAGE_DRIVER=s3-compatible
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_BUCKET=fetchit-documents
# STORAGE_S3_ACCESS_KEY_ID=<r2-access-key-id>
# STORAGE_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
#
# --- Also supported ---------------------------------------------------------
# The same variables work against Backblaze B2, Supabase Storage, MinIO and AWS
# S3; only STORAGE_S3_ENDPOINT (and, for AWS, STORAGE_S3_REGION) differ. Leave
# STORAGE_S3_ENDPOINT unset for AWS S3, which derives it from the region.
#
# --- Optional ---------------------------------------------------------------
# Base URL prepended to object keys when building the stored file URL (a CDN or
# an R2 public bucket domain). Leave unset for a private bucket.
# STORAGE_PUBLIC_BASE_URL=https://files.example.com
# Maximum accepted upload size in bytes (default 5242880 = 5 MB)
# STORAGE_MAX_FILE_SIZE=5242880
# Local driver only: directory uploads are written to
# STORAGE_LOCAL_ROOT=./storage/uploads
