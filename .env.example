# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
# REQUIRED. The frontend web app users open in a browser (NOT the API host).
# Verification email links and OAuth callback/redirect URLs are built from this.
# Per environment, e.g. dev: https://dev.fetchit.com.ng, prod: https://app.fetchit.com.ng
FRONTEND_URL=http://localhost:4200

# Database (Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fetchit?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (REDIS_URL takes precedence - use for Upstash/cloud providers)
# For Upstash: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379
# Note: The app is resilient to Redis failures - it will continue working
# with degraded functionality (no queues, no Redis cache) if Redis is down
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cache (pluggable: 'memory' or 'redis')
CACHE_TYPE=memory
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=fetchit:cache:
CACHE_MAX_ITEMS=1000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Swagger
SWAGGER_ENABLED=false
SWAGGER_TITLE=FetchIt API
SWAGGER_DESCRIPTION=FetchIt Backend API Documentation
SWAGGER_VERSION=1.0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=FetchIt <onboarding@resend.dev>
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=FetchIt

# ---------------------------------------------------------------------------
# Storage (pluggable object storage)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER selects the backend:
#   local            (default) filesystem. Development only - nothing serves
#                    these files over HTTP, deliberately.
#   s3-compatible    any object store speaking the S3 wire protocol.
#
# "S3-compatible" is a protocol name, not a vendor. No AWS account is involved.
#
# Routes that write to storage:
#   POST /handyman/documents/upload   verification documents (stores + records)
#   POST /uploads                     avatars and shopping receipts, returns a URL
#
# --- Recommended: Cloudflare R2 --------------------------------------------
# R2 speaks the S3 protocol, and its free tier covers this use case (handyman
# verification documents: a handful of MB per handyman) with a lot of headroom.
# R2 also charges nothing for egress, unlike most object stores. Check current
# limits and pricing at https://developers.cloudflare.com/r2/pricing/
#
# Create a bucket in the Cloudflare dashboard (R2 > Create bucket), then an R2
# API token (R2 > Manage API tokens) with Object Read & Write on that bucket.
# Keep the bucket PRIVATE - these are KYC documents.
#
# STORAGE_DRIVER=s3-compatible
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_BUCKET=fetchit-documents
# STORAGE_S3_ACCESS_KEY_ID=<r2-access-key-id>
# STORAGE_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
#
# --- Also supported ---------------------------------------------------------
# The same variables work against Backblaze B2, Supabase Storage, MinIO and AWS
# S3; only STORAGE_S3_ENDPOINT (and, for AWS, STORAGE_S3_REGION) differ. Leave
# STORAGE_S3_ENDPOINT unset for AWS S3, which derives it from the region.
#
# --- Optional ---------------------------------------------------------------
# Base URL prepended to object keys when building the stored file URL (a CDN or
# an R2 public bucket domain). Leave unset for a private bucket.
# STORAGE_PUBLIC_BASE_URL=https://files.example.com
# Maximum accepted upload size in bytes (default 5242880 = 5 MB)
# STORAGE_MAX_FILE_SIZE=5242880
# Local driver only: directory uploads are written to
# STORAGE_LOCAL_ROOT=./storage/uploads
